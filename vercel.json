{
  "version": 2,
  "name": "john-quality",
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "**/*.{html,js,json,css,jpg,jpeg,png,svg,ico,webp,woff,woff2,ttf}", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)\\.(js|css|json|jpg|jpeg|png|svg|ico|webp|woff|woff2|ttf)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
